# Your domain or nip.io fallback (e.g. 34.123.45.67.nip.io)
DOMAIN_NAME=api.yourdomain.com

# The public URL of your Vercel frontend (important for CORS)
FRONTEND_URL=https://your-frontend-url.vercel.app

# Neon Database Connection Strings
USER_DB_URL=postgresql://user:password@endpoint.neon.tech/user_db?sslmode=require
GROUP_DB_URL=postgresql://user:password@endpoint.neon.tech/group_db?sslmode=require
EXPENSE_DB_URL=postgresql://user:password@endpoint.neon.tech/expense_db?sslmode=require
SETTLEMENT_DB_URL=postgresql://user:password@endpoint.neon.tech/settlement_db?sslmode=require

# JWT Secret for authentication (must match between User Service and Gateway)
JWT_SECRET=generate_an_equally_secure_long_random_secret_string_here

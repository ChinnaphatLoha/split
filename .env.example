# Domain name pointing to your VPS IP for the Caddy auto-HTTPS proxy
# Example: api.example.com
DOMAIN_NAME=api.yourdomain.com

# The public URL of your Vercel frontend (important for CORS configuration on the Gateway)
# Example: https://split-frontend.vercel.app
FRONTEND_URL=https://your-frontend-url.vercel.app

# Secure PostgreSQL credentials used by all production databases and Go services
POSTGRES_USER=split_prod_admin
POSTGRES_PASSWORD=generate_a_very_secure_long_random_password_here

# JWT Secret for authentication (must match between User Service and Gateway)
JWT_SECRET=generate_an_equally_secure_long_random_secret_string_here
